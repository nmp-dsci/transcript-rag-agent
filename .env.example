# Copy to ~/.env (the default the app loads) and fill in your own keys.
# Override the path with YT_AGENT_ENV_PATH. Never commit a filled-in copy.

# --- Required API keys ---------------------------------------------------
SUPADATA_API_KEY=<your Supadata API key>
# SUPERDATA_API_KEY is also accepted for compatibility with earlier wording.
# Optional fallback keys, tried in order only after the key before them
# answers 429 "Plan usage limit was exceeded". Numbering must be contiguous.
# SUPADATA_API_KEY_2=<a second Supadata API key>
# SUPADATA_API_KEY_3=
DEEPSEEK_API_KEY=<your DeepSeek API key>
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Voice-to-text (optional) --------------------------------------------
# Streaming speech-to-text for the composer mic. Leave unset to run without
# the feature: /api/health reports stt=false and the mic never renders.
# The key stays server-side — the browser talks only to this app's /ws/stt.
DEEPGRAM_API_KEY=<your Deepgram API key>
YT_AGENT_STT_ENABLED=true
YT_AGENT_STT_MODEL=nova-3

# --- Storage / collections ----------------------------------------------
YT_AGENT_CHROMA_PATH=.yt-agent/chroma
YT_AGENT_RAW_TRANSCRIPT_COLLECTION=raw_transcripts
YT_AGENT_CHUNK_COLLECTION=transcript_chunks
YT_AGENT_TRANSCRIPT_SUMMARY_COLLECTION=transcript_summaries
# Where a video's routing summary comes from. description (default) uses the
# creator's YouTube description Supadata already returns, no LLM call. llm
# restores the DeepSeek summariser.
YT_AGENT_SUMMARY_SOURCE=description
# Below this many cleaned characters a description is too thin to route on
# and the video is recorded as summary_status=failed instead of indexed.
YT_AGENT_SUMMARY_MIN_CHARS=120
# Concurrent /api/index/queue jobs. Indexing is mostly network wait.
YT_AGENT_INGESTION_WORKERS=3

# --- Retrieval -----------------------------------------------------------
YT_AGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
YT_AGENT_RAG_TOP_K=10
YT_AGENT_TRANSCRIPT_FILTER_TOP_K=5
YT_AGENT_TRANSCRIPT_FILTER_MIN_SCORE=0.25
# semantic | hybrid. hybrid fuses semantic + BM25 with Reciprocal Rank Fusion.
YT_AGENT_RETRIEVAL_MODE=semantic
# Candidates pulled per retriever before fusion/rerank narrow to top_k.
YT_AGENT_RETRIEVAL_CANDIDATES=30
# Cross-encoder reranking is ON by default; set to false to retrieve without it.
YT_AGENT_RERANK_ENABLED=true
YT_AGENT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Paste N chunks either side of each hit into the context. 0 disables it.
YT_AGENT_NEIGHBOR_SPAN=0

# --- Retrieval variants (HyDE / multi-query / contextual) ----------------
# Rewrite the question before embedding it. none | hyde | multi_query.
# Expansions are cached per question, so a repeated sweep costs nothing.
YT_AGENT_QUERY_TRANSFORM=none
YT_AGENT_MULTI_QUERY_VARIANTS=3
YT_AGENT_QUERY_CACHE_PATH=.yt-agent/query_cache
# Contextual Retrieval: a parallel index of the same chunks, embedded with an
# LLM-written situating sentence. Built by `index-contextual`.
YT_AGENT_CONTEXTUAL_CHUNK_COLLECTION=transcript_chunks_contextual
YT_AGENT_CONTEXT_CACHE_PATH=.yt-agent/context_cache
# Read timeout on LLM calls. Without one, a socket that is accepted and never
# answered hangs the process — which is how a matrix run ignores its own budget.
YT_AGENT_LLM_TIMEOUT_SECONDS=120

# --- Recursive / agentic RAG --------------------------------------------
YT_AGENT_RAG_RECURSIVE_DEFAULT=false
YT_AGENT_RAG_MAX_DEPTH=1
YT_AGENT_RAG_MAX_FOLLOWUPS=3
YT_AGENT_RAG_FOLLOWUP_TOP_K=
YT_AGENT_RAG_NOVELTY_MIN_CHUNKS=2
YT_AGENT_RAG_MAX_TOTAL_FOLLOWUPS=
YT_AGENT_RAG_AGENT_MAX_ITERATIONS=10

# --- Chunking ------------------------------------------------------------
YT_AGENT_CHUNK_TARGET_CHARS=1200
YT_AGENT_CHUNK_OVERLAP_CHARS=150

# --- GraphRAG (P4) knowledge graph ---------------------------------------
# Neo4j runs locally via `docker compose up -d neo4j`. Defaults match
# docker-compose.yml; the graph is derived state, rebuilt with index-graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=yt-agent-graph
# Per-chunk extraction results, cached by chunk id + text hash.
YT_AGENT_GRAPH_CACHE_PATH=.yt-agent/graph_cache

# --- Evaluation / judging ------------------------------------------------
YT_AGENT_JUDGE_SAMPLES=1
# Grade with an independent (non-DeepSeek) judge — any OpenAI-compatible API.
# Leave unset to self-grade with the DeepSeek answer model.
# YT_AGENT_JUDGE_MODEL=gpt-4o-mini
# YT_AGENT_JUDGE_API_KEY=<your OpenAI API key>
# YT_AGENT_JUDGE_BASE_URL=https://api.openai.com/v1

# --- Supadata polling ----------------------------------------------------
YT_AGENT_DISCOVERY_CACHE_TTL_HOURS=24
SUPADATA_TIMEOUT_SECONDS=120
SUPADATA_POLL_INTERVAL_SECONDS=2
SUPADATA_MAX_POLL_SECONDS=600

# --- Observability -------------------------------------------------------
MLFLOW_TRACKING_URI=file:.yt-agent/mlruns
MLFLOW_EXPERIMENT_NAME=yt-agent-v1
YT_AGENT_LOG_TRANSCRIPT_ARTIFACTS=false

# Watched text sources (s26). Optional: the register defaults to channels.yaml
# at the repo root. Nothing on this path needs an API key.
# YT_AGENT_CHANNELS_FILE=channels.yaml
# YT_AGENT_WEB_SOURCE_COLLECTION=web_sources
# YT_AGENT_WEB_CHUNK_COLLECTION=web_chunks
